{
  "manifest_version": 2,
  "name": "FoxBridge",
  "version": "0.1.0",
  "description": "Lets Claude Code drive Firefox through a local bridge. © 2026 Jennifer K. Mellen",
  "author": "Jennifer K. Mellen",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxbridge@jkmellen",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["tabs", "<all_urls>", "webRequest"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start" }
  ],
  "browser_action": { "default_title": "FoxBridge", "default_icon": "icon.svg" },
  "icons": { "48": "icon.svg", "96": "icon.svg" }
}
