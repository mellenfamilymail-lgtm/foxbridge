{
  "manifest_version": "0.3",
  "name": "foxbridge",
  "display_name": "FoxBridge",
  "version": "0.1.0",
  "description": "Let Claude use your Firefox: tabs, pages, clicks, typing, forms, screenshots, console and network logs.",
  "long_description": "FoxBridge connects Claude to your own Firefox through a small add-on. Claude can list, open and switch tabs, read pages, click, type, fill forms, take screenshots, run JavaScript and read console and network logs. Everything stays on your computer (127.0.0.1). Install the FoxBridge add-on from addons.mozilla.org/firefox/addon/foxbridge-for-claude. © 2026 Jennifer K. Telfer",
  "author": {
    "name": "Jennifer K. Telfer",
    "email": "mellenfamilymail@gmail.com",
    "url": "https://github.com/mellenfamilymail-lgtm/foxbridge"
  },
  "homepage": "https://github.com/mellenfamilymail-lgtm/foxbridge",
  "documentation": "https://github.com/mellenfamilymail-lgtm/foxbridge#readme",
  "support": "https://github.com/mellenfamilymail-lgtm/foxbridge/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/mellenfamilymail-lgtm/foxbridge"
  },
  "icon": "icon.png",
  "license": "Proprietary",
  "keywords": [
    "firefox",
    "browser",
    "automation"
  ],
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ]
    }
  },
  "tools": [
    {
      "name": "tabs_list"
    },
    {
      "name": "tabs_create"
    },
    {
      "name": "tabs_close"
    },
    {
      "name": "tabs_select"
    },
    {
      "name": "navigate"
    },
    {
      "name": "screenshot"
    },
    {
      "name": "read_page"
    },
    {
      "name": "find"
    },
    {
      "name": "get_page_text"
    },
    {
      "name": "click"
    },
    {
      "name": "type"
    },
    {
      "name": "key"
    },
    {
      "name": "scroll"
    },
    {
      "name": "form_input"
    },
    {
      "name": "javascript"
    },
    {
      "name": "console_messages"
    },
    {
      "name": "network_requests"
    },
    {
      "name": "wait"
    }
  ],
  "compatibility": {
    "platforms": [
      "win32",
      "darwin",
      "linux"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}
